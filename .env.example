# Copy this file to .env.local and fill in once the OCR backend is hosted.
# Until VITE_OCR_API_URL is set, src/lib/ocr.js runs in mock mode and
# CaptureExpense.jsx shows sample extracted data instead of calling a real API.

# Base URL of the hosted OCR/AI-extraction backend (PaddleOCR + a model,
# wrapped behind our own API). The app POSTs the receipt image to
# `${VITE_OCR_API_URL}/scan` and expects JSON back — see the comment at the
# top of src/lib/ocr.js for the exact request/response shape.
VITE_OCR_API_URL=

# Optional bearer token if the OCR backend requires auth from the frontend.
# For production, prefer proxying through your own backend so no key is
# ever shipped to the browser.
VITE_OCR_API_KEY=

# Base URL of the real login/auth backend. Point this at wherever
# php-backend/api/login.php is deployed, e.g.:
#   VITE_AUTH_API_URL=https://your-php-host.example.com/api
# (the app calls "{VITE_AUTH_API_URL}/login"). That file proxies to the real
# reap.emeraldclothing.com login page (no DB credentials needed) — see the
# comment at the top of php-backend/api/login.php. Until this is set, login()
# runs in mock mode: the employee/manager toggle appears on the login screen
# and any non-empty password signs you in as a demo account.
VITE_AUTH_API_URL=
